{
  "name": "propresenter-remote",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "openapi:update": "node tools/openapi/update.mjs",
    "openapi:generate": "node tools/openapi/generate.mjs",
    "openapi:check": "node tools/openapi/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:readonly": "playwright test e2e/readonly.spec.ts",
    "e2e:observe": "playwright test e2e/observe.spec.ts",
    "e2e:live": "playwright test e2e/live-commands.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.22.0"
  }
}
